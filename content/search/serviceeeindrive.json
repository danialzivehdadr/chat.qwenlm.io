{
  "service": {
    "name": "Eein Drive",
    "version": "1.0.0",
    "baseUrl": "https://drive.eein.com",
    "status": "active"
  },
  
  "media": {
    "playPhoto": {
      "action": "play",
      "type": "photo",
      "source": "SD Card",
      "status": "playing",
      "response": "now"
    },
    
    "playVideo": {
      "local": {
        "action": "play",
        "type": "video",
        "source": "Local Files",
        "status": "playing",
        "response": "now"
      },
      
      "cloud": {
        "action": "play",
        "type": "video",
        "source": "Cloud Storage",
        "status": "playing",
        "response": "now"
      }
    }
  },
  
  "sharing": {
    "action": "Share",
    "files": {
      "types": ["PDF", "DOC", "PPT", "TXT", "XLS", "FILE"],
      "count": 5,
      "destination": {
        "service": "Eein Drive",
        "location": "drive://eein/root/",
        "url": "https://drive.eein.com/Dededt"
      }
    },
    
    "specificFile": {
      "name": "finance.xls",
      "type": "XLS",
      "size": "2.4 MB",
      "destination": {
        "service": "Eein Drive",
        "url": "https://drive.eein.com/Dededt",
        "path": "drive://eein/root/"
      },
      "status": "ok",
      "response": "now"
    },
    
    "result": {
      "status": "ok",
      "message": "5 files uploaded",
      "timestamp": "now"
    }
  },
  
  "addresses": {
    "url": {
      "type": "url",
      "address": "https://drive.eein.com/Dededt",
      "status": "active",
      "response": "now"
    },
    
    "voice": {
      "type": "voice",
      "address": "voice://eein/Dededt",
      "status": "active",
      "response": "now"
    },
    
    "localDirectory": {
      "type": "local_directory",
      "address": "ld://eein/Dededt",
      "status": "active",
      "response": "now"
    }
  },
  
  "supportedFormats": {
    "PDF": {
      "description": "Portable Document Format",
      "status": "supported"
    },
    "DOC": {
      "description": "Microsoft Word Document",
      "status": "supported"
    },
    "PPT": {
      "description": "PowerPoint Presentation",
      "status": "supported"
    },
    "TXT": {
      "description": "Plain Text File",
      "status": "supported"
    },
    "XLS": {
      "description": "Microsoft Excel Spreadsheet",
      "status": "supported"
    },
    "FILE": {
      "description": "Generic File",
      "status": "supported"
    }
  },
  
  "responseCodes": {
    "ok": "Operation completed successfully",
    "now": "Immediate response",
    "playing": "Media is currently playing",
    "active": "Address/Service is active"
  },
  
  "apiEndpoints": {
    "playPhoto": "GET /api/play/photo",
    "playVideo": "GET /api/play/video",
    "shareFiles": "POST /api/share",
    "getUrl": "GET /api/address/url",
    "getVoice": "GET /api/address/voice",
    "getLocalDir": "GET /api/address/ld"
  }
